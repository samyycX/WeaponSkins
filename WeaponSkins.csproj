<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyName>WeaponSkins</AssemblyName>
    <OutputPath>$(MSBuildThisFileDirectory)build/</OutputPath>
    <PublishDir>$(OutputPath)publish/WeaponSkins</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Must stay on the FluentMigrator major Ranks exports via resources/exports; SwiftlyS2 binds every plugin to that copy. -->
    <PackageReference Include="FluentMigrator" Version="8.*" />
    <PackageReference Include="FluentMigrator.Runner.Core" Version="8.*" />
    <PackageReference Include="FluentMigrator.Runner.MySql" Version="8.*" />
    <PackageReference Include="FluentMigrator.Runner.Postgres" Version="8.*" />
    <PackageReference Include="FluentMigrator.Runner.SQLite" Version="8.*" />
    <PackageReference Include="FreeSql" Version="3.5.303" />
    <PackageReference Include="FreeSql.Provider.MySql" Version="3.5.303" />
    <PackageReference Include="FreeSql.Provider.Sqlite" Version="3.5.303" />
    <PackageReference Include="FreeSql.Provider.PostgreSQL" Version="3.5.303" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Tomlyn" Version="0.19.0" />
    <PackageReference Include="Tomlyn.Extensions.Configuration" Version="1.0.6" />
    <PackageReference Include="ValveKeyValue" Version="0.20.0.417" />
    <!-- Not *-*: 1.5.1 betas raise the Microsoft.Extensions floor past the 10.0.0 pins above (NU1605). -->
    <PackageReference Include="SwiftlyS2.CS2" Version="1.5.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <ProjectReference Include="WeaponSkins.Shared\WeaponSkins.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="resources/templates/**/*;resources/translations/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="examples\**\*.cs" />
    <Compile Remove="WeaponSkins.Shared\**\*.cs" />
  </ItemGroup>

  <UsingTask TaskName="ExtractPluginVersion"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <FilePath ParameterType="System.String" Required="true" />
      <PluginVersion ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs">
        <![CDATA[
          var content = System.IO.File.ReadAllText(FilePath);
          var m = System.Text.RegularExpressions.Regex.Match(content, "Version\\s*=\\s*\"([^\"]+)\"");
          PluginVersion = m.Success ? m.Groups[1].Value : "";
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <!-- The contract ships in resources/exports as well as next to WeaponSkins.dll. SwiftlyS2 binds
       every plugin to the exports copy, snapshotted once at server start, and prefers it over the
       local one: a stale export left by an earlier install is exactly what fails Load with
       "Could not load type 'WeaponSkins.Shared.MusicKitDefinition'". The local copy only covers a
       hot install, before any export of it exists. -->
  <Target Name="CopyContract" AfterTargets="Build">
    <Copy SourceFiles="$(OutDir)WeaponSkins.Shared.dll" DestinationFolder="$(OutDir)resources/exports" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyContractToPublish" AfterTargets="Publish">
    <Error Condition="!Exists('$(PublishDir)WeaponSkins.Shared.dll')"
           Text="CopyContractToPublish: $(PublishDir)WeaponSkins.Shared.dll is missing from the publish output." />
    <Copy SourceFiles="$(PublishDir)WeaponSkins.Shared.dll" DestinationFolder="$(PublishDir)resources/exports" SkipUnchangedFiles="true" />
  </Target>

  <!-- PluginMetadata.Version is the only place the version lives; release.yml checks it against CHANGELOG.md. -->
  <Target Name="CreateZip" AfterTargets="Publish" DependsOnTargets="CopyContractToPublish">
    <ExtractPluginVersion FilePath="$(MSBuildThisFileDirectory)src/WeaponSkins.cs">
      <Output TaskParameter="PluginVersion" PropertyName="_PluginVersion" />
    </ExtractPluginVersion>
    <Error Condition="'$(_PluginVersion)' == ''"
           Text="CreateZip: failed to extract PluginMetadata.Version from src/WeaponSkins.cs." />

    <ZipDirectory SourceDirectory="$(PublishDir)../" DestinationFile="$(OutputPath)../$(AssemblyName)-v$(_PluginVersion).zip" Overwrite="true" />
  </Target>

</Project> 
